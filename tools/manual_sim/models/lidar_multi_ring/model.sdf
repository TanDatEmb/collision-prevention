<?xml version="1.0"?>
<!-- Manual-flight copy of the bench multi-ring lidar (tools/scenarios/models/lidar_multi_ring, issue #138, ADR 0022
     decision 4), cut to the Mid-360S point density: 360 azimuth steps (1 degree) by 56 rings, at 10 Hz. Simulation
     asset, not a platform value; the real scan pattern is NOT claimed. Field of view, range, noise and ring-major
     order are those of the bench model. The grid is closed on the azimuth side (last azimuth pi - 2*pi/360).
     tools/manual_sim/layout.yaml holds the matching layout for obstacle_sector_node. -->
<sdf version="1.9">
  <model name="lidar_multi_ring">
    <link name="lidar_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.37</mass>
        <inertia>
          <ixx>0.00034437749999999994</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00034437749999999994</iyy>
          <iyz>0</iyz>
          <izz>0.00022199999999999998</izz>
        </inertia>
      </inertial>
      <!-- The housing is 0.06 m wide, so every point of it is closer than the 0.1 m minimum range. -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.06 0.06 0.06</size>
          </box>
        </geometry>
      </visual>
      <sensor name="lidar_multi_ring" type="gpu_lidar">
        <gz_frame_id>lidar_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.141593</min_angle>
              <max_angle>3.124139</max_angle>
            </horizontal>
            <vertical>
              <samples>56</samples>
              <resolution>1</resolution>
              <min_angle>-0.122173</min_angle>
              <max_angle>0.907571</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>50</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.001</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
