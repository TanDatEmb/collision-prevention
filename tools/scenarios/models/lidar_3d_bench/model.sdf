<?xml version="1.0"?>
<!-- Bench multi-ring lidar for issue #138 (ADR 0022 decision 4). Simulation asset, not a platform value.
     Field of view: -7 to +52 degrees vertical from the boresight, 360 degrees horizontal, as the
     Mid-360S (ICD-CP-01). The scan pattern and the point density of the real sensor are NOT claimed:
     this is a regular grid, 720 azimuth steps (0.5 degree) by 60 rings (1 degree), at 10 Hz (the map
     rate). The range is 50 m, beyond the 40 m qualified range of the map, so that empty rays count as
     clear evidence (as the 2D bench model, issue #127). Gaussian range noise 0.001 m as the stock model.

     The grid is regular and closed on the azimuth side: the last azimuth is
     pi - 2*pi/720, so that no azimuth is sampled twice. Ranges in the gz message are ring-major,
     index = ring * 720 + azimuth_step (checked by tools/scenarios/check_lidar_rings.py).

     The link frame is the sensor frame (x forward, y left, z up). The vehicle model sets the mount. -->
<sdf version="1.9">
  <model name="lidar_3d_bench">
    <link name="lidar_3d_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.37</mass>
        <inertia>
          <ixx>0.00034437749999999994</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00034437749999999994</iyy>
          <iyz>0</iyz>
          <izz>0.00022199999999999998</izz>
        </inertia>
      </inertial>
      <!-- The housing is 0.06 m wide, so every point of it is closer than the 0.1 m minimum range. -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.06 0.06 0.06</size>
          </box>
        </geometry>
      </visual>
      <sensor name="lidar_3d_bench" type="gpu_lidar">
        <gz_frame_id>lidar_3d_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.141593</min_angle>
              <max_angle>3.132866</max_angle>
            </horizontal>
            <vertical>
              <samples>60</samples>
              <resolution>1</resolution>
              <min_angle>-0.122173</min_angle>
              <max_angle>0.907571</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>50</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.001</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
