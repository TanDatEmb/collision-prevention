<?xml version="1.0" encoding="UTF-8"?>
<!-- The PX4 X500 with the multi-ring bench lidar at mount R1 (ADR 0022, owner decision 2026-11-21).
     Simulation asset, not a platform value.

     Mount R1: the sensor is at (0.12, 0, 0.14) m from base_link, pitched 0.1745 rad (10 degrees) with the
     boresight down (a positive SDF pitch turns +x towards -z).
     FRAME TRAP: base_link is 0.24 m above the origin of this model (x500_base is included at z 0.24), and
     Gazebo ground truth is the model origin, so the sensor is at z 0.14 + 0.24 = 0.38 m in this model
     frame. The lever arm from base_link is sqrt(0.12^2 + 0.14^2) = 0.184 m. -->
<sdf version="1.9">
  <model name="x500_lidar_3d_bench">
    <include merge="true">
      <uri>x500</uri>
    </include>
    <include merge="true">
      <uri>model://lidar_3d_bench</uri>
      <pose>0.12 0 0.38 0 0.17453293 0</pose>
    </include>
    <joint name="Lidar3dBenchJoint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_3d_link</child>
    </joint>
  </model>
</sdf>
